PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://patchkite:patchkite@localhost:5432/patchkite
# Storage driver: s3 | fs
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=patchkite
S3_ACCESS_KEY_ID=patchkite
S3_SECRET_ACCESS_KEY=patchkite-secret
S3_FORCE_PATH_STYLE=true
FS_STORAGE_DIR=./data/blobs
# Number of previous releases to generate diffs against
DIFF_HISTORY_DEPTH=5
# Dashboard build folder served statically (optional)
DASHBOARD_DIR=
# redirect (S3 presigned URL, S3 must be reachable by devices) | proxy (stream through the server)
BLOB_DOWNLOAD_MODE=redirect
# S3 endpoint for presigned URLs if different from S3_ENDPOINT (e.g. in Docker)
S3_PUBLIC_ENDPOINT=
# Max upload zip size and total extracted size (zip bomb protection), in MB
MAX_PACKAGE_SIZE_MB=200
MAX_UNCOMPRESSED_SIZE_MB=1024
# false = only admins can create accounts (the first account can always register and becomes admin)
ALLOW_REGISTRATION=true
# Rate limit per IP per minute: SDK endpoints and login/registration (0 = unlimited)
RATE_LIMIT_PUBLIC_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
# true when behind a reverse proxy (Caddy/Nginx/load balancer) so client IPs are read correctly
TRUST_PROXY=false
# Orphaned blob cleanup in storage: interval (0 = disabled) and minimum blob age, in minutes
GC_INTERVAL_MINUTES=60
GC_GRACE_MINUTES=60
# Binary patches (bsdiff) for large changed files (JS bundle, libapp.so), generated in the background
BSDIFF_ENABLED=true
BSDIFF_MIN_FILE_KB=32
# bsdiff needs roughly 10x the file size in memory
BSDIFF_MAX_FILE_MB=64
