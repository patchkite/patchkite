# Copy to docker/.env and fill in. Used by docker-compose.prod.yml.

# Public domain of the server (DNS A/AAAA records must already point to this host)
PATCHKITE_DOMAIN=patchkite.example.com

# Database password (generate a random one, e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# S3-compatible storage: AWS S3, Cloudflare R2, or your own RustFS/MinIO
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=patchkite
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# redirect = devices download directly from S3 (endpoint must be public); proxy = through the server
BLOB_DOWNLOAD_MODE=redirect

# Disable once the first admin account has been created
ALLOW_REGISTRATION=false
